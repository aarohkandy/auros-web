---
/**
 * BuildConsole — spec §7's replacement for every decorative animation impulse, and D29's living
 * element. Both rest on the same property, so it is worth stating before the code: **every line
 * this component renders was printed by a machine that ran.**
 *
 * WHAT IT SHOWS, IN ORDER OF PREFERENCE
 *
 *   1. A build happening now, streamed from the Worker's SSE endpoint. Lines land when they land.
 *   2. Otherwise — which is most of the time — **the last real run**, server-rendered from
 *      `src/lib/console/last-build.json`, labelled with when it happened and linked to the run so
 *      a reader can open it and find the same line. That file is written by
 *      `tools/snapshot-build-log.mjs` out of the GitHub Actions API and committed.
 *   3. If we have no record of a run at all, it says so, in one sentence, and shows the content
 *      author's ILLUSTRATION of what build output looks like, carrying `ILLUSTRATION_LABEL`
 *      visibly in the panel (§4.4, CONFIGURATOR.md constraint 3) rather than in a footnote.
 *
 * And under all three, THE RECORD: a pinned set of real runs from `src/lib/console/notable-runs.json`
 * — the runs that measured the runner, that booted a 4.4 GB disk image to a login prompt, and that
 * broke for reasons worth reading. Pinned by run id, so they stay after the latest build has moved
 * on, each with the sentence saying why it is worth a stranger's attention and a link to itself.
 *
 * There is no fourth state and no filler. Nothing in this component or in `lib/console/` can
 * synthesise a line of output — no sample array reachable from the live path, no scripted pacing,
 * no typewriter, no fake latency. A console that could invent output, on a page whose argument is
 * that we tell you exactly what we removed, would be the worst defect on this site.
 *
 * FAILURES ARE SHOWN, AND THE SET IS MECHANICALLY MIXED. The latest run is whatever it is on the
 * day — on the day this was written every completed `build.yml` run on main had failed, so the
 * console showed a ✗, and that is left in. A console that has only ever been green reads as staged;
 * so does one that has only ever been red. So the pinned set must contain at least one success AND
 * at least one failure, refused in two places: `--notable` will not write such a file, and
 * `notable.ts` will not render one. `tools/build-console.test.mjs` breaks both on purpose and
 * watches them go red, because D34's rule is that a check nobody has seen fail is not a check.
 *
 * MOTION. It is a log, not an animation. It may move because it is reporting a fact (§7), so live
 * lines appear as they arrive and the view follows the tail — but only if the reader was already at
 * the tail, and not at all under `prefers-reduced-motion`. There is no per-line transition in
 * either mode; a log does not need one to be alive.
 */
import { buildConsole, ILLUSTRATION_LABEL } from "../content/copy";
import Panel from "./Panel.astro";
import {
  lastBuild,
  elapsed,
  formatDuration,
  shortSha,
  utcStamp,
  type BuildLine,
} from "../lib/console/snapshot";
import { notableRuns } from "../lib/console/notable";

interface Props {
  /**
   * The Worker's SSE route, as `worker/routes/build-console.js` actually implements it:
   * `text/event-stream`, events named `hello` / `job` / `step` / `stale` / `status` / `idle` /
   * `done` / `reconnect`, each with a JSON payload, and an `id:` derived from the run's own
   * structure so a cut stream resumes exactly where it stopped.
   */
  endpoint?: string;
  /**
   * Which build to watch. The Worker REFUSES a request naming neither, and its reason is worth
   * repeating rather than working around: there is no "whatever is building right now", because
   * that would leak which customers exist. A page with no build to name therefore streams nothing
   * and shows the state below — which is the state of every page on the site today.
   */
  recipe?: string | undefined;
  run?: string | undefined;
  headingLevel?: 2 | 3;
}

const { endpoint = "/build-console", recipe, run, headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}` as any;

const snap = lastBuild;
const failed = snap?.run.conclusion === "failure";

/**
 * UI strings for states the content file does not cover. Written in the voice of `copy.ts` and kept
 * here rather than added to it, because `src/content/` belongs to another agent. Each one describes
 * an absence or a fact accurately; none of them implies a build we cannot show.
 */
const strings = {
  live: buildConsole.liveLabel,
  connecting: "connecting",
  stale: "stored output, not live",
  unavailable: "no live output",
  finished: "build finished",
  nothing: "no build to show",
  /** The client rewrites {time} as the same instant in the reader's own timezone. */
  lastBuild: "last build · {time}",
  nothingNote:
    "We have no record of a completed run to show you here, and we would rather show you an empty console than a convincing one. Every build we have ever run is public: the workflows and their logs are in the repositories linked in the footer.",
  noscript:
    "The live stream needs JavaScript. What you are reading above is the last build that actually ran, rendered into this page when the site was built.",
};

/** The footer sentence. Two versions because the run's outcome is a fact and it differs. */
const outcomeNote = failed
  ? "This run stopped on a ✗, so nothing was published. The publish step reads the attestation ledger and there is no flag that skips it — which is why a red line here is a better advertisement than a green one."
  : "Every line above had to be green before the :hardened tag could move. The publish step reads the attestation ledger and there is no flag that skips it.";

/**
 * The reducer keeps the lines that say what the image now contains and drops progress bars, package
 * tables and directory listings. Saying so, with both numbers, is cheaper than being asked — and a
 * ratio a reader can check against the linked run is worth more than a claim that we showed
 * everything, which would not be true.
 */
const selectionNote = snap
  ? `${snap.linesShown} lines of ${(snap.linesInLog ?? snap.linesShown).toLocaleString("en-GB")}; the rest is progress bars and package tables, and the whole log is at the run above.`
  : "";

const logLabel = snap
  ? `Build output from ${snap.run.repo} run number ${snap.run.runNumber}`
  : buildConsole.title;

const lines: BuildLine[] = snap?.lines ?? [];

/**
 * The pinned set. `notableRuns` is `[]` unless the committed file parses AND contains at least one
 * success and at least one failure, so this section either shows both outcomes or does not exist.
 * There is no arrangement of the data that produces an all-green record here.
 */
const notable = notableRuns;
const SubH = `h${headingLevel + 1}` as any;
const greens = notable.filter((r) => r.run.conclusion === "success").length;
const reds = notable.length - greens;
const recordNote =
  `${notable.length} runs kept on the record: ${greens} that passed, ${reds} that did not. ` +
  "They are pinned by run id, so they stay here after the latest build has moved on. " +
  "Every line under each one came off that run's own log and the link goes to it.";
---

<Panel
  tone="deep"
  as="section"
  class="console"
  data-build-console
  data-state={snap ? "snapshot" : "nothing"}
  data-has-snapshot={snap ? "true" : "false"}
  data-endpoint={endpoint}
  data-recipe={recipe}
  data-run={run}
  data-string-live={strings.live}
  data-string-connecting={strings.connecting}
  data-string-stale={strings.stale}
  data-string-unavailable={strings.unavailable}
  data-string-finished={strings.finished}
  data-string-nothing={strings.nothing}
  data-string-last-build={strings.lastBuild}
>
  <header class="head">
    <H class="title">{buildConsole.title}</H>
    <p class="status" data-console-status role="status">
      {snap ? strings.lastBuild.replace("{time}", utcStamp(snap.run.startedAt)) : strings.nothing}
    </p>
  </header>
  <p class="subtitle">{buildConsole.subtitle}</p>

  {
    snap && (
      <div class="run" data-console-run>
        <p class="run-subject">{snap.run.title}</p>
        <p class="run-facts">
          <a class="run-link" href={snap.run.url} rel="noopener">
            {snap.run.repo} · {snap.run.workflow} #{snap.run.runNumber}
          </a>
          <span aria-hidden="true">·</span>
          <span>{shortSha(snap.run.headSha)}</span>
          <span aria-hidden="true">·</span>
          <span>{formatDuration(snap.run.durationSeconds)}</span>
          <span aria-hidden="true">·</span>
          <span data-outcome={snap.run.conclusion}>{failed ? "failed" : "passed"}</span>
          <span aria-hidden="true">·</span>
          <time data-console-when datetime={snap.run.startedAt}>
            {utcStamp(snap.run.startedAt)}
          </time>
        </p>
      </div>
    )
  }

  <p class="wire-note" data-console-note hidden></p>

  {/*
     `role="log"` lives on this DIV and not on the <ol> inside it. Measured, not preferred: axe's
     `aria-allowed-role` refuses `log` on an <ol> — the element's implicit role is `list` and `log`
     is not one of the roles HTML-ARIA permits it to take — and overriding it ALSO orphaned every
     <li>, which then failed `listitem` ("List item parent element has a role that is not
     role=list"). Two accessibility audits red on three pages, for one attribute in the wrong place.
     Splitting them keeps both meanings: the region is a log, and the lines are still a list. */}
  <div class="log-region" data-console-region role="log" aria-live="off" tabindex="0" aria-label={logLabel}>
    <ol class="log" data-console-log role="list">
    {
      lines.map((line) => (
        <li class="line" data-level={line.level}>
          <span class="at" aria-hidden="true">
            {snap ? elapsed(line.at, snap.run.startedAt) : ""}
          </span>
          <span class="text">{line.text}</span>
        </li>
      ))
    }
    </ol>
  </div>

  {
    snap ? (
      <p class="note">
        {outcomeNote} <span class="ratio">{selectionNote}</span>
      </p>
    ) : (
      <p class="note">{strings.nothingNote}</p>
    )
  }

  <noscript>
    <p class="note">{snap ? strings.noscript : strings.nothingNote}</p>
  </noscript>

  {
    /*
      The record. Server-rendered, so it is identical with JavaScript off — `<details>` is the
      browser's own disclosure, not a widget, and the whole log of every pinned run is in the DOM
      whether it is open or not. Deliberately asymmetric: the sentence about why the run matters
      gets the width of a sentence, the machine facts sit under it in mono, and the runs are not a
      grid of equal cards.
    */
    notable.length > 0 && (
      <section class="record" aria-label="Runs kept on the record">
        <SubH class="record-title">On the record</SubH>
        <p class="note record-note">{recordNote}</p>
        {notable.map((item, i) => (
          <details class="pin" open={i === 0}>
            <summary class="pin-summary">
              <span class="pin-mark" data-outcome={item.run.conclusion} aria-hidden="true" />
              <span class="pin-what">
                {item.run.workflow} #{item.run.runNumber}
              </span>
              <span class="pin-when">
                <time datetime={item.run.startedAt}>{utcStamp(item.run.startedAt)}</time>
              </span>
              <span class="pin-outcome">
                {item.run.conclusion === "success" ? "passed" : "failed"}
              </span>
            </summary>
            <p class="pin-why">{item.why}</p>
            <p class="run-facts">
              <a class="run-link" href={item.run.url} rel="noopener">
                {item.run.repo} · run {item.run.runId}
              </a>
              <span aria-hidden="true">·</span>
              <span>{shortSha(item.run.headSha)}</span>
              <span aria-hidden="true">·</span>
              <span>{formatDuration(item.run.durationSeconds)}</span>
            </p>
            {/* Same split as the main log above, for the same measured reason: axe's
                `aria-allowed-role` refuses `log` on an <ol>, and forcing it there orphans every
                <li>. The region is the log; the lines are still a list. */}
            <div
              class="log-region pin-log"
              role="log"
              aria-live="off"
              tabindex="0"
              aria-label={`Output from ${item.run.repo} run ${item.run.runId}`}
            >
              <ol class="log" role="list">
                {item.lines.map((line) => (
                  <li class="line" data-level={line.level}>
                    <span class="at" aria-hidden="true">
                      {elapsed(line.at, item.run.startedAt)}
                    </span>
                    <span class="text">{line.text}</span>
                  </li>
                ))}
              </ol>
            </div>
          </details>
        ))}
      </section>
    )
  }

  {
    !snap && (
      <div class="illustration">
        <p class="illustration-label">
          <span class="flag">ILLUSTRATION</span>
          {ILLUSTRATION_LABEL}
        </p>
        <ol class="log sample" aria-label="Illustration of build output">
          {buildConsole.sampleLinesMono.map((line) => (
            <li class="line" data-level="info">
              <span class="text">{line}</span>
            </li>
          ))}
        </ol>
        <dl class="legend">
          {buildConsole.legend.map((item) => (
            <div class="legend-row">
              <dt>{item.label}</dt>
              <dd>{item.meaning}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</Panel>

<script>
  import { mountBuildConsoles } from "../lib/console/client";
  mountBuildConsoles();
</script>

<style>
  .console {
    color: var(--ink-console, #e2ddd0);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--rule-deep, #8a7358);
    padding-bottom: 0.5rem;
  }
  .title {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-2, 1.5rem);
    line-height: var(--leading-tight, 1.1);
    margin: 0;
    color: var(--ink-console, #e2ddd0);
  }
  .status {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.78rem);
    margin: 0;
    color: var(--ink-console, #e2ddd0);
  }
  /* `live` is the one state worth catching out of the corner of an eye, so it is the one state
     that carries a mark. Ore is never a glyph (CONVENTIONS.md §2), so the mark is a border, and it
     appears because a build is genuinely running — not because the page wants to look busy. */
  .console[data-state="live"] .status {
    border-left: 3px solid var(--ore-deep, #d9682e);
    padding-left: 0.45rem;
  }
  .subtitle {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: var(--step-0, 0.9rem);
    line-height: var(--leading-body, 1.5);
    margin: 0.75rem 0 1rem;
    max-width: var(--measure, 62ch);
    color: var(--ink-console, #e2ddd0);
  }

  /* ── the run's identity ──────────────────────────────────────────────────────────────────────
     Deliberately asymmetric: the commit subject is a sentence a person wrote and gets the width of
     one, while the machine facts sit under it in mono as a single dense line. Not a card grid. */
  .run {
    margin: 0 0 0.85rem;
    border-left: 3px solid var(--ore-deep, #d9682e);
    padding-left: 0.85rem;
  }
  .run-subject {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-1, 1.15rem);
    line-height: var(--leading-snug, 1.25);
    margin: 0 0 0.3rem;
    max-width: 48ch;
    color: var(--ink-console, #e2ddd0);
  }
  .run-facts {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.72rem);
    line-height: 1.6;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    color: var(--ink-muted-deep, #a8afa2);
  }
  .run-link {
    color: var(--ink-console, #e2ddd0);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .run-facts [data-outcome="failure"]::before {
    content: "✗ ";
  }
  .run-facts [data-outcome="success"]::before {
    content: "✓ ";
  }

  /* ── the log ─────────────────────────────────────────────────────────────────────────────────
     A scroll region, not a truncation: every line is in the DOM, reachable by keyboard and by a
     screen reader. `role="log"` with `aria-live="off"` is the combination that lets someone READ
     the log without being read every new line as it lands. */
  .log-region {
    max-height: 20rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--rule-deep, #8a7358);
    border-bottom: 1px solid var(--rule-deep, #8a7358);
  }
  .log-region:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--ore-deep, #d9682e);
    outline-offset: var(--focus-ring-offset, 2px);
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0;
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.72rem);
    line-height: 1.65;
  }
  .line {
    display: flex;
    gap: 0.7rem;
    padding: 0 0.2rem;
    color: var(--ink-console, #e2ddd0);
  }
  .at {
    flex: 0 0 auto;
    width: 3.2rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted-deep, #a8afa2);
  }
  .text {
    white-space: pre-wrap;
    word-break: break-word;
    min-width: 0;
  }
  /* Detail lines recede so the checks stand out. Both are legible; one is louder. */
  .line[data-level="info"] .text,
  .line[data-level="note"] .text,
  .line[data-level="meta"] .text {
    color: var(--ink-muted-deep, #a8afa2);
  }
  /* A step boundary. A hairline is the only divider §7 allows, so a step boundary is a hairline. */
  .line[data-level="section"] {
    margin-top: 0.55rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--rule-deep, #8a7358);
  }
  .line[data-level="section"]:first-child {
    margin-top: 0;
    border-top: 0;
  }
  /* Failures are marked, not coloured: ore never carries a glyph (CONVENTIONS.md §2, measured).
     The ✗ in the line is the real signal and it came off the runner; this is the gutter mark. */
  .line[data-level="bad"] {
    border-left: 3px solid var(--ore-deep, #d9682e);
    padding-left: 0.35rem;
    margin-left: -0.15rem;
  }
  .line[data-level="warn"] {
    border-left: 1px solid var(--ore-deep, #d9682e);
    padding-left: 0.45rem;
    margin-left: 0.05rem;
  }

  /* The Worker's own words about why there is no live output. Attributed by position — it sits
     above the log, outside it — because it is a sentence about the stream, not a line from it. */
  .wire-note {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: var(--step-0, 0.85rem);
    line-height: var(--leading-body, 1.5);
    margin: 0 0 0.7rem;
    max-width: var(--measure, 62ch);
    border-left: 1px solid var(--ore-deep, #d9682e);
    padding-left: 0.7rem;
    color: var(--ink-console, #e2ddd0);
  }
  .note {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: var(--step-0, 0.85rem);
    line-height: var(--leading-body, 1.5);
    margin: 0.8rem 0 0;
    max-width: var(--measure, 62ch);
    color: var(--ink-console, #e2ddd0);
  }

  /* ── the no-record fallback ──────────────────────────────────────────────────────────────── */
  .illustration {
    margin-top: 1.25rem;
    border-top: 1px solid var(--rule-deep, #8a7358);
    padding-top: 1rem;
    border-left: 3px solid var(--ore-deep, #d9682e);
    padding-left: 0.85rem;
  }
  .illustration-label {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: var(--step-0, 0.82rem);
    line-height: var(--leading-body, 1.5);
    margin: 0 0 0.75rem;
    color: var(--ink-console, #e2ddd0);
  }
  .flag {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.7rem);
    letter-spacing: 0.08em;
    border: 1px solid var(--rule-deep, #8a7358);
    border-radius: 2px;
    padding: 0.1rem 0.35rem;
    margin-right: 0.5rem;
    white-space: nowrap;
  }
  .sample {
    max-height: none;
    border: 0;
  }
  .legend {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  /*
     A stacked glossary, at the same label/value rhythm as FactList — not three equal columns.
     D29 bans "symmetric three-up card grids. Icon + heading + two hedged sentences, repeated",
     and a three-column dl of term-plus-a-sentence is that shape with the icon removed. This
     reads as terminal documentation, which is what it is.
  */
  .legend-row {
    display: grid;
    gap: 0.15rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule-deep, #8a7358);
  }
  @media (min-width: 40rem) {
    .legend-row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1rem;
      align-items: baseline;
    }
  }
  .legend dt {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.75rem);
    color: var(--ink-console, #e2ddd0);
  }
  .legend dd {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: var(--step-0, 0.85rem);
    line-height: var(--leading-body, 1.5);
    margin: 0;
    color: var(--ink-console, #e2ddd0);
  }

  @media (min-width: 48rem) {
    /* The log is the page's living element (§7, D29), so on a screen with room it gets room: about
       twenty lines, enough that the shape of a build — sections, checks, the ✗ — is visible at once
       rather than through a slot. */
    .log-region {
      max-height: 32rem;
    }
  }
  .ratio {
    color: var(--ink-muted-deep, #a8afa2);
  }
  @media (max-width: 30rem) {
    /* The elapsed gutter is the first thing to go on a narrow screen: it is orientation, and the
       line itself is the fact. */
    .at {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* No auto-scroll (the client checks the same query) and no smooth scrolling anywhere in here.
       The log stays complete in the DOM and fully readable; what is removed is the movement. */
    .log-region {
      scroll-behavior: auto;
    }
  }

  /* ── the record ──────────────────────────────────────────────────────────────────────────────
     A stack of disclosures, not a card grid (D29 bans the symmetric three-up). `<details>` is the
     browser's own control, so this section behaves the same with JavaScript off — which matters
     here more than anywhere else on the page, because the thing it degrades to is the evidence. */
  .record {
    margin-top: 1.4rem;
    border-top: 1px solid var(--rule-deep, #8a7358);
    padding-top: 1rem;
  }
  .record-title {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-1, 1.15rem);
    line-height: var(--leading-snug, 1.25);
    margin: 0 0 0.4rem;
    color: var(--ink-console, #e2ddd0);
  }
  .record-note {
    margin-top: 0;
  }
  .pin {
    margin-top: 0.9rem;
    border-top: 1px solid var(--rule-deep, #8a7358);
    padding-top: 0.7rem;
  }
  .pin-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    cursor: pointer;
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.74rem);
