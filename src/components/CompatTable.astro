---
/**
 * `hardware/compat.tsv`, printed with as many rows as it has, which today is none.
 *
 * SPEC §8 says build this file from hour one, because after fifty rows it is the thing a competitor
 * cannot copy quickly. It currently holds a header and nothing under it: no physical machine has
 * been imaged. Every other mention of this table on the site describes it. This one shows it.
 *
 * Why the empty table rather than a sentence saying the table is empty: seventeen column headings
 * with nothing under them tell a reader what we intend to measure, in the order we intend to
 * measure it, and admit in the same object that we have measured none of it. That is a harder thing
 * to fake than a filled table, and it is the only table on the internet a competitor cannot claim
 * to be ahead of us on without showing theirs.
 *
 * Every string is the content author's (`copy.compatTable`). §4.4: inventing a row here would be
 * inventing a customer's hardware, and `tools/honesty-gate.mjs` is not the only reason not to.
 *
 * The horizontal scroll belongs to the table and never to the page — seventeen columns do not fit
 * on a phone, and squeezing them to fit would trade a readable row for a tidier screenshot. The
 * box is focusable so it can be scrolled from a keyboard as well as a trackpad.
 */
import Panel from "./Panel.astro";
import { compatTable } from "../content/copy";

interface Props {
  headingLevel?: 2 | 3;
  class?: string;
}
const { headingLevel = 2, class: className } = Astro.props;
const H = `h${headingLevel}` as any;
---

<Panel tone="panel" as="section" class:list={["compat", className]}>
  <header class="head">
    <H class="title">{compatTable.title}</H>
    <p class="as-of">{compatTable.asOfMono}</p>
  </header>

  <div class="scroller" tabindex="0" role="region" aria-label={compatTable.title}>
    <table>
      <thead>
        <tr>
          {compatTable.columnsMono.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="empty" colspan={compatTable.columnsMono.length}>{compatTable.emptyStateMono}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="body">
    {compatTable.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Panel>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .title {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-2, 1.5rem);
    line-height: 1.15;
    margin: 0;
    color: var(--ink, #24231f);
  }
  .as-of {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.8125rem);
    margin: 0;
    color: var(--ink-muted, #5a4e40);
  }

  /* The hairline above and below is the table's frame. §7 gives it no other one. */
  .scroller {
    overflow-x: auto;
    border-block: 1px solid var(--rule, #8a7358);
  }
  .scroller:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus, #be3a12);
    outline-offset: 2px;
  }
  table {
    border-collapse: collapse;
    width: max-content;
    min-width: 100%;
  }
  th {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-weight: 400;
    font-size: 0.72rem;
    text-align: start;
    white-space: nowrap;
    padding: 0.6rem 1.25rem 0.6rem 0;
    color: var(--ink-muted, #5a4e40);
    border-block-end: 1px solid var(--rule, #8a7358);
  }
  th:last-child {
    padding-right: 0;
  }
  /* The empty row is set in mono at the size of a row, not shrunk into a caption. It is the
     table's current contents and it is meant to be read as such. */
  .empty {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: 0.82rem;
    padding: 1.1rem 0;
    color: var(--ink-muted, #5a4e40);
  }
  .body {
    margin-top: 1.1rem;
  }
  .body p {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: var(--measure, 38rem);
    margin: 0 0 0.85rem;
    color: var(--ink, #24231f);
  }
  .body p:last-child {
    margin-bottom: 0;
  }
</style>
