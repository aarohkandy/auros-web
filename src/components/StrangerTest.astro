---
/**
 * The replaceability claim, tested weekly by something that is not us.
 *
 * `auros-recipes/.github/workflows/replaceable.yml` runs a job called `stranger`. It gets a
 * container with podman, git and nothing of ours — no Node, no toolchain, no account — clones the
 * public repository the way this page tells a reader to, and runs the command printed on this page
 * verbatim. If an image does not come out, the build goes red, and it goes red long before anybody
 * needs the command to work.
 *
 * This is on the site because the workflow's own header gives the reason: an untested claim on the
 * page a sceptical IT person reads first is the worst possible place for one. The site had the
 * claim and did not mention that the test exists. The schedule is read from the workflow file at
 * build time, so the day and time on this page cannot drift from the cron that runs it.
 */
import Panel from "./Panel.astro";
import { schedules } from "./facts";

interface Props {
  headingLevel?: 2 | 3;
  class?: string;
}
const { headingLevel = 2, class: className } = Astro.props;
const H = `h${headingLevel}` as any;

const facts = [
  { label: "workflow", value: "stranger · auros-recipes" },
  { label: "runs", value: `${schedules.strangerDayMono}s, ${schedules.strangerMono}` },
  { label: "has", value: "podman · git" },
  { label: "has not", value: "our toolchain · our registry credentials · an account with us" },
];
---

<Panel tone="panel" as="section" class:list={["stranger", className]}>
  <p class="eyebrow">The commands on this page are tested by a stranger</p>
  <H class="title">Every {schedules.strangerDayMono} at {schedules.strangerMono}</H>

  <p class="body">
    A container with podman, git and nothing of ours clones the public repository, runs the command
    printed above exactly as it is printed, and waits to see whether an operating system comes out.
    When it does not, the build goes red — on a {schedules.strangerDayMono.toLowerCase()}, with
    nothing wrong, months before the week you would actually need this to work.
  </p>

  <dl class="facts">
    {
      facts.map((fact) => (
        <div class="fact">
          <dt>{fact.label}</dt>
          <dd class="mono">{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  <p class="provenance">
    <span class="mono">{schedules.strangerSourcePath}</span>. It is in the public repository, so the
    schedule, the container and the command it runs are all things you can read rather than things
    we have told you.
  </p>
</Panel>

<style>
  .eyebrow {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    color: var(--ink-muted, #5a4e40);
  }
  .title {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-3, 2rem);
    line-height: 1.1;
    margin: 0 0 0.85rem;
    color: var(--ink, #24231f);
  }
  .body {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: 1rem;
    line-height: 1.6;
    max-width: var(--measure, 38rem);
    margin: 0 0 1.25rem;
    color: var(--ink, #24231f);
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 0.4rem;
    border-block-start: 1px solid var(--rule, #8a7358);
    padding-block-start: 0.85rem;
  }
  .fact {
    display: grid;
    gap: 0.1rem;
  }
  .facts dt {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: 0.72rem;
    color: var(--ink-muted, #5a4e40);
  }
  .facts dd {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink, #24231f);
  }
  .mono {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
  }
  .provenance {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 1rem 0 0;
    max-width: var(--measure, 38rem);
    color: var(--ink-muted, #5a4e40);
  }
  @media (min-width: 34rem) {
    .fact {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 0.75rem;
      align-items: baseline;
    }
  }
</style>
