---
/**
 * The margin label that names which layer of the real architecture the reader is passing.
 *
 * Spec §7: the terrain background IS the architecture diagram, and each stratum is "labelled in
 * the margin as they pass it". So this label is not decoration on top of a picture — it is the
 * legend for it, and it has to match the stack the company actually builds:
 *
 *   surface     your machine
 *   topsoil     your apps, your language, your look
 *   stratum 1   your recipe
 *   stratum 2   auros-base:hardened
 *   bedrock     Fedora · Universal Blue
 *
 * It reads those names from the `layers` collection rather than restating them, so the margin and
 * the /how-it-works page cannot drift apart. If the collection entry is missing, the label renders
 * nothing at all: an unnamed stratum is better than a guessed one.
 */
import { layerById, type LayerEntry } from "./content";
import { layerStack } from "../content/copy";

interface Props {
  /** Which stratum. Matches the terrain renderer's stratum index via the collection's `id`. */
  layer: LayerEntry["data"]["id"];
  /** Hide from assistive tech where the same words are already in the page text. */
  decorative?: boolean;
}

const { layer, decorative = false } = Astro.props;
const entry = await layerById(layer);
const data = entry?.data;
const ownedBy = data ? layerStack.ownedByLabels[data.ownedBy] : undefined;
---

{
  data && (
    <aside
      class="stratum"
      data-layer={data.id}
      data-depth={data.depth}
      aria-hidden={decorative ? "true" : undefined}
    >
      <p class="margin-label">{data.marginLabel}</p>
      <p class="name">{data.name}</p>
      {data.refMono && <p class="ref">{data.refMono}</p>}
      {ownedBy && <p class="owned">{ownedBy}</p>}
    </aside>
  )
}

<style>
  /*
    The label is a margin label, so it sits in the rail beside the stratum rather than on top of
    the panel — `.with-margin-label` in base.css is the grid that puts it there, and §7's "labelled
    in the margin as they pass it" is the sentence that asks for it.

    It carries its own opaque background because in the rail there is no panel under it and §7 says
    the terrain never reduces the contrast of text. A label drawn straight onto the canvas is a pair
    `tools/contrast.mjs` cannot measure, and a rule nobody can measure is a rule nobody keeps.

    No ore. Ore marks a layer boundary in the terrain, the ILLUSTRATION flag and the focus ring, and
    nothing else on this site — an accent on every block is not an accent, it is a card decoration.
    The hairline is §7's only divider and it is what separates this from what it labels.
  */
  .stratum {
    background-color: var(--panel, #f4f1ea);
    border-block-start: 1px solid var(--rule, #8a7358);
    padding: 0.55rem 0.75rem 0.7rem 0;
    margin: 0 0 1rem;
    max-width: 16rem;
  }
  /* "Labelled in the margin AS THEY PASS IT" is a description of scrolling, so in the rail the
     label holds beside its stratum instead of scrolling away at the first paragraph. Only where
     the rail exists: at phone width the label is stacked above the panel, and sticking it there
     would pin a caption over the text it captions. Position only — nothing moves that is not
     reporting a fact, and this reports which layer you are at. */
  @media (min-width: 64rem) {
    :global(.with-margin-label) > .stratum {
      position: sticky;
      top: var(--space-6, 32px);
      margin-bottom: 0;
    }
  }
  .margin-label,
  .ref {
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: var(--step--1, 0.8125rem);
    line-height: 1.4;
    margin: 0;
    color: var(--ink-muted, #5a4e40);
  }
  .margin-label {
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }
  .name {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-1, 1.1875rem);
    line-height: 1.2;
    margin: 0.3rem 0 0.15rem;
    color: var(--ink, #24231f);
  }
  .owned {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: 0.8rem;
    line-height: 1.4;
    margin: 0.3rem 0 0;
    color: var(--ink-muted, #5a4e40);
  }

  /*
    In the rail, the label holds beside its section while the reader passes it — which is what "as
    they pass it" describes. It only sticks where the rail exists; stacked above a panel on a
    narrow screen, sticking would pin a caption over the text it captions.
    Sticky is a position, not an animation: nothing here moves relative to the scroll.
  */
  @media (min-width: 64rem) {
    .stratum {
      position: sticky;
      top: var(--space-6, 32px);
      margin-bottom: 0;
      padding-block-end: 0.9rem;
    }
  }
</style>
