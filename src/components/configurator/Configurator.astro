---
/**
 * The configurator: the panel and the four questions, together.
 *
 * LAYOUT DECISIONS THAT ARE ARGUMENTS, NOT TASTE
 *
 * The panel comes FIRST IN THE DOCUMENT. On a phone that puts it above the form, which
 * `CONFIGURATOR.md` requires so a phone user meets the argument before the work. On a desktop
 * grid it sits in the right-hand column without moving in the document, so a screen reader and
 * a keyboard reach it in the same order everywhere: here is the machine you would get, and
 * here is how to change it.
 *
 * The panel is NOT sticky and has NO max-height. A sticky panel needs a scroll box, a scroll
 * box truncates, and the one rule this whole workstream has is that the prune block is never
 * truncated. Losing the sticky behaviour is the cheaper thing to lose.
 *
 * WITHOUT JAVASCRIPT the form is not there at all, and the fallback says why rather than
 * showing a dead form. Turnstile has no `<noscript>` path and the Worker never accepts a POST
 * without a valid token, so a form that looked submittable would be a lie about what happens
 * when you press the button. The panel still renders, because a file you can read is worth
 * having even when you cannot edit it here.
 */
import { configurator, site } from "../../content/copy";
import RecipePanel from "./RecipePanel.astro";
import AnswerForm from "./AnswerForm.astro";

interface Props {
  /** Where the Worker lives. It re-validates this recipe server-side before writing anything. */
  endpoint?: string;
}
const { endpoint = "/api/order" } = Astro.props;

const mailtoSubject = encodeURIComponent("Auros build, configured by hand");
const mailtoBody = encodeURIComponent(
  [
    "This is the degraded path. It is not the same as the configurator: nothing here is validated",
    "against the schema as you type, and no pull request is opened by sending it.",
    "",
    "How many machines:",
    "Roughly what age:",
    "What they are (models), if you know:",
    "What kind of place this is (school or nonprofit / business / just me):",
    "",
    "What language the machines should be in:",
    "What is printed on the keys:",
    "",
    "What people actually do on these (browse, write documents, email, print, scan, video calls,",
    "USB drives, wireless accessories, learning programs, software development, remote support):",
    "Anything not on that list should be deleted:",
    "",
    "Who is allowed to change things (anyone / staff only / nobody / single-purpose machine):",
    "",
    "I have read what does not come across, including that Windows programs do not run on Linux:",
  ].join("\n"),
);
---

<section class="cfg" data-configurator data-endpoint={endpoint} aria-labelledby="cfg-title">
  <header class="cfg__head">
    <h1 class="cfg__title" id="cfg-title">{configurator.title}</h1>
    <p class="cfg__standfirst">{configurator.standfirst}</p>
  </header>

  <div class="cfg__layout">
    <!-- First in the document on purpose. See the note at the top of this file. -->
    <div class="cfg__panel">
      <RecipePanel />
    </div>

    <div class="cfg__form">
      <div data-form-mount>
        <p class="cfg__booting">{configurator.emptyState}</p>
      </div>

      <noscript>
        <div class="cfg__noscript">
          <h2 class="cfg__noscript-title">This form needs JavaScript, and we are not going to fake it</h2>
          <p>{configurator.noJsFallback}</p>
          <p>
            The honest reason: every submission passes a human check before the server will look at it,
            that check has no version that works without JavaScript, and the server refuses a submission
            without it. A form here that appeared to work would be a form that could not send. So there
            is no form here.
          </p>
          <p>
            This is a degraded path, not an equivalent one. Emailing us gets a person writing your recipe
            by hand and sending you the file to read. It does not open a pull request by itself, and
            nothing is built until you have read the file and said yes.
          </p>
          <p>
            <a href={`mailto:${site.contactEmail}?subject=${mailtoSubject}&body=${mailtoBody}`}>
              Email the answers to {site.contactEmail}
            </a>
          </p>
          <p class="cfg__noscript-note">
            That address is a placeholder until a human sets a real one. The file on this page is a real
            recipe in the starting state, and it is the same file the form would build.
          </p>
        </div>
      </noscript>
    </div>
  </div>

  <AnswerForm />
</section>

<script>
  import "./configurator.client";
</script>

<style>
  .cfg {
    /* One place where every colour and typeface this component uses is named. Each one defers
       to the site token if the design system has published it, and falls back to the spec 7
       palette literal if it has not. No gradients, no shadows, 3px radius ceiling, hairline
       rules: those are section 7 rules and they are not negotiable here either. */
    --cfg-ink: var(--auros-ink, #24231f);
    --cfg-ink-soft: var(--auros-ink-muted, #5a4e40);
    --cfg-panel: var(--auros-panel, #f4f1ea);
    --cfg-panel-deep: var(--auros-panel-alt, #e6e0d2);
    --cfg-field: var(--auros-field, #ffffff);
    --cfg-rule: var(--auros-rule, #8a7358);
    --cfg-ore: var(--auros-accent, #be3a12);
    --cfg-mark: var(--auros-mark, rgba(190, 58, 18, 0.14));
    --cfg-mono: var(--auros-font-mono, "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace);
    --cfg-sans: var(--auros-font-sans, "IBM Plex Sans", system-ui, -apple-system, sans-serif);
    --cfg-display: var(--auros-font-display, "Instrument Serif", Georgia, serif);

    display: grid;
    gap: 1.5rem;
    /* A 16px gutter at phone width, and never a horizontal scrollbar. */
    padding: 0 1rem;
    max-width: 78rem;
    margin: 0 auto;
    overflow-x: hidden;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .cfg {
      --cfg-ink: var(--auros-ink, #e2ddd0);
      --cfg-ink-soft: var(--auros-ink-muted, #a8afa2);
      --cfg-panel: var(--auros-panel, #1e242c);
      --cfg-panel-deep: var(--auros-panel-alt, #171c24);
      --cfg-field: var(--auros-field, #171c24);
      --cfg-rule: var(--auros-rule, #463e34);
      /* Ore stays ore. On the dark panel it is used for rules, marks and the chip fill, where
         3:1 is the bar; the chip's own text is white, which clears 4.5:1 against it. Refusal
         headings are set in --cfg-ink rather than ore, because ore on #1e242c is 2.9:1 and
         WCAG AA on every text and panel pair is verified, not assumed. */
      --cfg-mark: var(--auros-mark, rgba(217, 104, 46, 0.22));
    }
  }

  :global(:root[data-theme="dark"]) .cfg {
    --cfg-ink: var(--auros-ink, #e2ddd0);
    --cfg-ink-soft: var(--auros-ink-muted, #a8afa2);
    --cfg-panel: var(--auros-panel, #1e242c);
    --cfg-panel-deep: var(--auros-panel-alt, #171c24);
    --cfg-field: var(--auros-field, #171c24);
    --cfg-rule: var(--auros-rule, #463e34);
    --cfg-mark: var(--auros-mark, rgba(217, 104, 46, 0.22));
  }

  .cfg__head {
    display: grid;
    gap: 0.5rem;
    max-width: 44rem;
  }

  .cfg__title {
    font-family: var(--cfg-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem);
    line-height: 1.05;
    margin: 0;
    color: var(--cfg-ink);
  }

  .cfg__standfirst {
    font-family: var(--cfg-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0;
    color: var(--cfg-ink);
  }

  .cfg__layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  /* Two columns only when there is room for the file to be legible in one of them. Below that
     it is one column, panel first, which is the document order anyway. */
  @media (min-width: 62rem) {
    .cfg__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
    .cfg__panel {
      grid-column: 2;
      grid-row: 1;
    }
    .cfg__form {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .cfg__booting {
    font-family: var(--cfg-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--cfg-ink-soft);
    margin: 0;
  }
  .cfg[data-ready="true"] .cfg__booting {
    display: none;
  }

  .cfg__noscript {
    background: var(--cfg-panel);
    color: var(--cfg-ink);
    border: 1px solid var(--cfg-rule);
    border-left: 3px solid var(--cfg-ore);
    border-radius: 3px;
    padding: 1rem;
    font-family: var(--cfg-sans);
    display: grid;
    gap: 0.6rem;
  }
  .cfg__noscript p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .cfg__noscript-title {
    font-family: var(--cfg-display);
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.2;
    margin: 0;
  }
  .cfg__noscript-note {
    color: var(--cfg-ink-soft);
    font-size: 0.8125rem !important;
  }
  .cfg__noscript a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .cfg__noscript a:focus-visible {
    outline: 2px solid var(--cfg-ore);
    outline-offset: 2px;
  }
</style>
