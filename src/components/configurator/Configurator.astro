---
/**
 * The configurator: the panel and the four questions, together.
 *
 * WHAT THIS COMPONENT DOES NOT DO
 * `src/pages/configure.astro` owns the frame — the `<h1>`, the standfirst, the privacy warning,
 * the full migration inventory and the site-wide `<noscript>` block. None of that is repeated
 * here. This component is the panel, the questions, and the wiring between them.
 *
 * LAYOUT DECISIONS THAT ARE ARGUMENTS, NOT TASTE
 *
 * The panel comes FIRST IN THE DOCUMENT. On a phone that puts it above the form, which
 * `CONFIGURATOR.md` requires so a phone user meets the argument before the work. On a desktop
 * grid it sits in the right-hand column without moving in the document, so a screen reader and
 * a keyboard reach it in the same order everywhere: here is the machine you would get, and
 * here is how to change it.
 *
 * The panel is NOT sticky and has NO max-height. A sticky panel needs a scroll box, a scroll
 * box truncates, and the one rule this whole workstream has is that the prune block is never
 * truncated. Losing the sticky behaviour is the cheaper thing to lose.
 *
 * WITHOUT JAVASCRIPT the form is not there at all. Turnstile has no `<noscript>` path and the
 * Worker never accepts a POST without a valid token, so a form that looked submittable would be
 * a lie about what happens when you press the button. The panel still renders, because a file
 * you can read is worth having even when you cannot edit it here.
 *
 * TOKENS
 * Per `src/components/CONVENTIONS.md`: every colour and typeface is `var(--token, <fallback>)`
 * with a spec section 7 palette literal as the fallback, and the dark theme is the styles
 * agent's — these components carry no dark rules of their own. ORE IS NEVER A GLYPH COLOUR:
 * `#BE3A12` is 2.83:1 on the dark panel and `#D9682E` is 4.39:1, both under AA, so ore is only
 * ever a border, a background or a mark here.
 */
import RecipePanel from "./RecipePanel.astro";
import AnswerForm from "./AnswerForm.astro";

interface Props {
  /** Where the Worker lives. It re-validates this recipe server-side before writing anything. */
  endpoint?: string;
}
const { endpoint = "/api/order" } = Astro.props;
---

<section class="cfg" data-configurator data-endpoint={endpoint} aria-label="Configure a build">
  <div class="cfg__layout">
    <!-- First in the document on purpose. See the note at the top of this file. -->
    <div class="cfg__panel">
      <RecipePanel />
    </div>

    <div class="cfg__form">
      <div data-form-mount>
        <p class="cfg__booting">
          The questions load in a moment. The file beside them is real either way.
        </p>
      </div>

      <noscript>
        <div class="cfg__noscript">
          <p>
            The questions need JavaScript, and there is no version of them here that does not.
            Every submission passes a human check before the server will look at it, that check has
            no path that works without JavaScript, and the server refuses a submission without it.
            A form here that looked live would be a form that could not send, so there is not one.
          </p>
          <p>
            The file above is a real recipe in its starting state, and it is the same file these
            questions build. The email fallback is further down this page. It is a degraded path,
            not an equivalent one: it gets you a person writing the recipe by hand and sending you
            the file to read, rather than a pull request you opened yourself.
          </p>
        </div>
      </noscript>
    </div>
  </div>

  <AnswerForm />
</section>

<script>
  import "./configurator.client";
</script>

<style>
  .cfg {
    /* The one value this component defines rather than borrows. It is a mark, not text: the
       line under it keeps its own colour, and the composite was measured at 9.9:1 light and
       9.5:1 dark against --ink. */
    --cfg-mark: rgba(190, 58, 18, 0.14);

    display: grid;
    gap: 1.5rem;
    /* A 16px gutter at phone width, and never a horizontal scrollbar. */
    padding: 0 1rem;
    max-width: 78rem;
    margin: 0 auto;
    overflow-x: hidden;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .cfg {
      --cfg-mark: rgba(217, 104, 46, 0.22);
    }
  }
  :global(:root[data-theme="dark"]) .cfg {
    --cfg-mark: rgba(217, 104, 46, 0.22);
  }

  .cfg__layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  /* Two columns only when there is room for the file to be legible in one of them. Below that
     it is one column, panel first, which is the document order anyway. */
  @media (min-width: 62rem) {
    .cfg__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
    .cfg__panel {
      grid-column: 2;
      grid-row: 1;
    }
    .cfg__form {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .cfg__booting {
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-muted, #5a4e40);
    margin: 0;
    /* Opaque, like every other block of text here. Section 7: the background never reduces the
       contrast of text, which means text is never drawn straight onto it. */
    background: var(--panel, #f4f1ea);
    border: 1px solid var(--rule, #8a7358);
    border-radius: 3px;
    padding: 0.75rem;
  }
  .cfg[data-ready="true"] .cfg__booting {
    display: none;
  }

  .cfg__noscript {
    background: var(--panel, #f4f1ea);
    color: var(--ink, #24231f);
    border: 1px solid var(--rule, #8a7358);
    border-left: 3px solid var(--ore, #be3a12);
    border-radius: 3px;
    padding: 1rem;
    font-family: var(--font-ui, "IBM Plex Sans", system-ui, sans-serif);
    display: grid;
    gap: 0.6rem;
  }
  .cfg__noscript p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>
