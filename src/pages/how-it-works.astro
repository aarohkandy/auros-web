---
/**
 * How it works — the five layers, read from the bottom up.
 *
 * The document ends on a "## The stack" heading with no list under it, because the stack is the
 * `layers` collection and belongs to the terrain, not to prose. This page renders the document and
 * then the stack itself, so the two halves of the same diagram sit together and neither is a
 * paraphrase of the other.
 */
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Panel from "../components/Panel.astro";
import Prose from "../components/Prose.astro";
import LayerStack from "../components/LayerStack.astro";
import BuildConsole from "../components/BuildConsole.astro";
import { pageByOrder, renderEntry, PAGE_ORDER } from "../components/content";
import { site } from "../content/copy";

const page = await pageByOrder(PAGE_ORDER.howItWorks);
const { Content } = await renderEntry(page);
---

<PageShell
  title={`${page.data.navLabel} — ${site.name}`}
  description={page.data.summary}
  layer={page.data.layer}
>
  <PageHeader page={page} />

  <Panel tone="panel">
    <Prose>
      <Content />
    </Prose>
  </Panel>

  <div class="stack-section">
    <LayerStack fromBottom headingLevel={2} />
  </div>

  <div class="console-section">
    <BuildConsole headingLevel={2} />
  </div>
</PageShell>

<style>
  .stack-section,
  .console-section {
    margin-top: 2rem;
  }
</style>
