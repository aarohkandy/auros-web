---
/**
 * Pricing. The tiers are §9-reserved and fixed; every figure on this page is read from
 * `src/content/tiers/` and none is computed here. The school tier carries the replacement-cost
 * comparison beside it, which is arithmetic with the reader's own numbers and never a saving
 * (spec §4.4, §6D).
 */
import PageShell from "../components/PageShell.astro";
import PageHeader from "../components/PageHeader.astro";
import Panel from "../components/Panel.astro";
import Prose from "../components/Prose.astro";
import PriceTable from "../components/PriceTable.astro";
import { pageByOrder, renderEntry, PAGE_ORDER } from "../components/content";
import { site, pricing } from "../content/copy";

const page = await pageByOrder(PAGE_ORDER.pricing);
const { Content } = await renderEntry(page);
---

<PageShell
  title={`${page.data.navLabel} — ${site.name}`}
  description={page.data.summary}
  layer={page.data.layer}
>
  <PageHeader page={page} />

  <div class="document">
    <Panel tone="panel">
      <Prose>
        <Content />
      </Prose>
    </Panel>
  </div>

  <Panel tone="panel" class="table-head">
    <h2 class="table-title">{pricing.title}</h2>
  </Panel>
  <PriceTable headingLevel={3} />
</PageShell>

<style>
  /*
    Prose is one measure wide and Prose.astro already caps it. The panel AROUND it was the thing
    running the full 72rem, which left a column of empty panel beside every paragraph and made
    every section on the page the same width as every other — the shape a template has when it has
    accepted content rather than been laid out. The panel is constrained; the type is untouched.
  */
  .document :global(.panel) {
    max-width: calc(var(--measure, 38rem) + 4rem);
  }

  /*
    A section marker, not a band. This panel holds one word, and at full width one word in a
    72rem box reads as an empty row somebody forgot to fill. It shrinks to its heading.
  */
  .table-head {
    margin: var(--space-8, 3rem) 0 1rem;
    width: fit-content;
    min-width: min(100%, 14rem);
  }
  .table-title {
    font-family: var(--font-display, "Instrument Serif", Georgia, serif);
    font-weight: 400;
    font-size: var(--step-3, 2rem);
    line-height: 1.15;
    margin: 0;
    color: var(--ink, #24231f);
  }
</style>
